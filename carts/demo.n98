-- nevel-98 cartridge v1
__meta__
title=Last Train Home
author=NEVEL-98
__lua__
-- LAST TRAIN HOME
-- a short NEVEL-98 demo novel
--
-- songs: 0 title, 1 night, 2 dawn
-- sfx:   40 station chime, 41 train rumble
-- images: title, frame, station, street, dawn, rei, rei_smile, rei_sad
--
-- Every line of text lives in the TEXT editor (F3), in English and
-- Italian. In the code a string that starts with "@" is a text key:
--   say("@char.rei", "@rei.hi1")   is the same as
--   say(tr("char.rei"), tr("rei.hi1"))
-- Players switch language in Settings.

speaker("@char.rei", 7)

---------------------------------------------------------------------------
-- seven-segment clock for the side panel
---------------------------------------------------------------------------
local SEGS = {
  ["0"] = "abcdef", ["1"] = "bc", ["2"] = "abdeg", ["3"] = "abcdg", ["4"] = "bcfg",
  ["5"] = "acdfg", ["6"] = "acdefg", ["7"] = "abc", ["8"] = "abcdefg", ["9"] = "abcdfg",
}

local function digit(ch, x, y, on, off)
  local w, h, t = 18, 34, 4
  local segs = {
    a = { x + t, y, w - 2 * t, t }, d = { x + t, y + h - t, w - 2 * t, t }, g = { x + t, y + (h - t) // 2, w - 2 * t, t },
    f = { x, y + t, t, (h - 3 * t) // 2 + 1 }, b = { x + w - t, y + t, t, (h - 3 * t) // 2 + 1 },
    e = { x, y + (h + t) // 2, t, (h - 3 * t) // 2 }, c = { x + w - t, y + (h + t) // 2, t, (h - 3 * t) // 2 },
  }
  local lit = SEGS[ch] or ""
  for name, r in pairs(segs) do
    rectfill(r[1], r[2], r[3], r[4], lit:find(name) and on or off)
  end
end

local function clock(text, x, y)
  local cx = x
  for i = 1, #text do
    local ch = text:sub(i, i)
    if ch == ":" then
      if (frame() // 30) % 2 == 0 then
        rectfill(cx + 2, y + 9, 4, 4, 7)
        rectfill(cx + 2, y + 21, 4, 4, 7)
      end
      cx = cx + 10
    else
      digit(ch, cx, y, 7, 9)
      cx = cx + 24
    end
  end
end

local function hud()
  -- date plate
  printx(flag.date or "12/31", 488, 22, 1, 2)
  print(tr(flag.day or "hud.sat"), 586, 38, 8)
  -- red LED clock
  clock(flag.clock or "23:52", 496, 76)
  -- command panel heading
  local head = tr("hud.command")
  print(head, 552 - textw(head) // 2, 133, 1)
end

layout("game", {
  view = { 16, 16, 448, 264 },
  frame = "frame",
  hud = hud,
  menu = { 486, 156, 130 }, menu_step = 21, menu_text_dx = 20,
  menu_bar = 3, menu_bar_dx = 15,
  menu_sel = 6, menu_idle = 8,
  choices = "window",
  window = { x = 16, y = 298, w = 608, h = 92, style = "none", bg = 0, fg = 6, border = 8,
             name_style = "plate", name_x = 46, name_y = 288, cursor = 1 },
})

-- rain inside the scene window
effect("rain", function(t)
  for i = 0, 60 do
    local x = (i * 97 + flr(t * 900)) % 480 - 16
    local y = (i * 53 + flr(t * 1400)) % 300 - 20
    line(x, y, x - 4, y + 12, 4)
  end
end)

-- Rei's three faces: "smile", "sad" or the default
local FACES = { smile = "rei_smile", sad = "rei_sad" }
local function rei(face, pos, transition)
  show(FACES[face] or "rei", pos or "right", transition)
end

local function endings_found()
  persist.endings = persist.endings or {}
  local n = 0
  for _ in pairs(persist.endings) do n = n + 1 end
  return n
end

local function ending(id)
  persist.endings = persist.endings or {}
  persist.endings[id] = true
  remember()
  music(nil, 2)
  fadeout(1.5)
  layout(nil)
  the_end("@end." .. id)
end

local function set_clock(t) flag.clock = t end
local function gain(stat, n) flag[stat] = (flag[stat] or 0) + n end
local function new_year() flag.clock, flag.date, flag.day = "00:00", "01/01", "hud.sun" end

---------------------------------------------------------------------------
-- scenes
---------------------------------------------------------------------------
scene("title", function()
  layout(nil)
  title_screen{
    bg = "title",
    music = 0,
    title = "@title.name",
    subtitle = function() return tr("title.sub", endings_found()) end,
    scale = 3,
    title_x = 148, title_y = 150, menu_x = 148, menu_y = 300,
    title_color = 6, text_color = 1,
  }
  jump("start")
end)

scene("start", function()
  music(nil)
  flag.date, flag.day = "12/31", "hud.sat"
  flag.trust, flag.courage = 0, 0    -- hidden: how understood Rei feels / how ready I am to face home
  set_clock("23:52")
  layout("game")
  bg(0)
  say("@start.date")
  bg("station", "dither", 1.2)
  music(1, 2)
  effect("rain")
  say("@start.board")
  say("@start.missed")
  sfx(40)
  say("@start.pager")
  say("@start.pager2")
  say("@start.pager3")
  say("@start.pager4")

  -- look around before sitting down: what you notice comes back later
  while true do
    local c = menu{ "@menu.look", "@menu.board", "@menu.drink", "@menu.sit" }
    if c == 1 then
      flag.carving = true
      say("@look.1")
      say("@look.2")
    elseif c == 2 then
      if not flag.board then gain("courage", 1) end
      flag.board = true
      say("@board.1")
      say("@board.2")
    elseif c == 3 then
      if flag.soda then say("@drink.again")
      else
        flag.soda = true
        say("@drink.1")
        say("@drink.2")
      end
    else
      break
    end
  end

  set_clock("23:55")
  say("@start.sit")
  sfx(40)
  wait(1)
  say("@start.chime")
  rei("smile", "right", "dither")
  say("@char.rei", "@rei.hi1")
  say("@char.rei", "@rei.hi2")

  if choice{ "@c.who", "@c.letgo" } == 1 then
    say("@char.rei", "@rei.who")
    say("@char.rei", "@rei.who2")
  else
    gain("courage", 1)
    gain("trust", 1)
    rei("sad")
    say("@char.rei", "@rei.letgo")
    say("@char.rei", "@rei.letgo2")
  end

  -- what is she waiting for?
  rei()
  say("@p.waiting")
  rei("sad")
  say("@char.rei", "@rei.wait1")
  rei("smile")
  say("@char.rei", "@rei.wait2")
  say("@p.maybe")
  rei("sad")
  say("@char.rei", "@rei.wait3")
  rei("smile")
  say("@char.rei", "@rei.wait4")
  if flag.carving then say("@start.carving") end

  if flag.soda then
    gain("trust", 1)
    say("@char.rei", "@rei.soda")
    say("@start.soda")
  end

  rei()
  say("@start.city")
  say("@char.rei", "@rei.city")
  say("@char.rei", "@rei.city2")

  sfx(40)
  say("@start.pager5")
  say("@char.rei", "@rei.pager")
  if choice{ "@c.tell", "@c.dodge" } == 1 then
    gain("courage", 1)
    gain("trust", 1)
    say("@p.tell")
    say("@char.rei", "@rei.tell1")
    say("@p.tell2")
    rei("smile")
    say("@char.rei", "@rei.tell2")
  else
    say("@char.rei", "@rei.dodge")
    rei("sad")
    say("@char.rei", "@rei.dodge2")
  end
  rei("smile")
  say("@char.rei", "@rei.pager2")

  -- the question nobody asks her
  if choice{ "@c.thanks", "@c.ask" } == 2 then
    gain("trust", 1)
    rei("sad")
    say("@char.rei", "@rei.ask1")
    say("@char.rei", "@rei.ask2")
    rei("smile")
    say("@char.rei", "@rei.ask3")
    say("@start.ask4")
    local r = choice{ "@c.pretend", "@c.song", "@c.gohome" }
    if r == 1 then
      gain("trust", 2)
      gain("courage", 1)
      rei("sad")
      say("@char.rei", "@rei.pretend")
      say("@start.pretend")
    elseif r == 2 then
      gain("trust", 1)
      say("@char.rei", "@rei.song")
    else
      rei("sad")
      say("@char.rei", "@rei.gohome")
    end
  else
    say("@char.rei", "@rei.thanks")
  end

  -- the radio that plays next year's songs
  rei()
  say("@start.radio")
  say("@char.rei", "@rei.radio")
  sfx(40)
  say("@start.radio2")
  music(2, 2)
  set_clock("23:58")
  say("@start.song")
  say("@char.rei", "@rei.best")
  say("@p.future")
  rei("smile")
  say("@char.rei", "@rei.best2")
  rei("sad")
  say("@char.rei", "@rei.best3")
  if choice{ "@c.notknow", "@c.foryou" } == 1 then
    rei()
    say("@char.rei", "@rei.notknow")
  else
    gain("trust", 1)
    say("@char.rei", "@rei.foryou")
  end
  rei("sad")
  say("@char.rei", "@rei.stop")

  if choice({ "@c.stay", "@c.walk" }, "@q.midnight") == 1 then jump("platform") else jump("street") end
end)

-- THE LONG WAY: no miracle, just a phone call
scene("street", function()
  hide(nil)
  bg("street", "wipe", 1.0)
  music(1, 1)
  effect("rain")
  say("@street.1")
  say("@street.2")
  sfx(41)
  quake(0.8, 5)
  say("@street.3")
  set_clock("23:59")
  say("@street.4")
  say("@street.5")
  if choice{ "@c.runback", "@c.keep" } == 1 then
    flag.ran = true
    jump("platform")
  end
  say("@street.6")
  say("@street.7")
  say("@street.8")
  new_year()
  say("@street.9")
  music(nil, 1)
  effect(nil)
  bg("dawn", "dither", 1.5)
  music(2, 2)
  say("@street.10")
  say("@street.11")
  ending("long_way")
end)

-- HOME: I go back alone, and she stays on the platform
local function go_home()
  rei("smile")
  say("@char.rei", "@rei.guilt")
  say("@plat.alone")
  hide(nil, "dither", 1.0)
  music(nil, 1)
  effect(nil)
  bg("dawn", "curtain", 2.0)
  music(2)
  say("@plat.morning")
  if flag.soda then say("@plat.soda") end
  say("@plat.call")
  say("@plat.next")
  ending("home")
end

scene("platform", function()
  layout("game")
  bg("station", flag.ran and "wipe" or nil, 0.8)
  effect("rain")
  if flag.ran then
    gain("trust", 1)
    say("@plat.ran")
    rei("smile", "right", "dither")
    say("@char.rei", "@rei.back")
  else
    rei("smile")
    say("@char.rei", "@rei.stayed")
  end
  rei()
  say("@char.rei", "@rei.here")

  -- midnight: the train that shouldn't exist
  new_year()
  sfx(40)
  say("@plat.train")
  sfx(41)
  quake(0.6, 3)
  say("@plat.train2")
  say(flag.board and "@plat.board_yes" or "@plat.board_no")
  rei("sad")
  say("@char.rei", "@rei.yours")
  say("@p.yours")
  say("@char.rei", "@rei.mine")
  say("@p.how")
  rei("smile")
  say("@char.rei", "@rei.just")
  say("@plat.decide")

  if choice{ "@c.alone", "@c.together" } == 1 then
    go_home()
    return
  end

  -- she only lets someone in if she feels understood, and if I mean it
  if (flag.trust or 0) < 4 or (flag.courage or 0) < 2 then
    say("@char.rei", "@rei.fine")
    say("@plat.fine")
    go_home()
    return
  end

  -- NEXT YEAR
  rei("sad")
  say("@char.rei", "@rei.angry")
  say("@char.rei", "@rei.angry2")
  say("@plat.mirror")
  say("@char.rei", "@rei.admit")
  rei()
  say("@char.rei", "@rei.home")
  say("@p.waiting2")
  rei("smile")
  say("@char.rei", "@rei.admit2")
  flash(0xFFF, 0.6)
  music(nil, 1)
  hide(nil)
  effect(nil)
  bg("dawn", "curtain", 2.0)
  music(2)
  rei("smile", "left", "dither")
  say("@plat.dawn")
  say("@char.rei", "@rei.dawn")
  rei(nil, "left")
  say("@plat.newsong")
  rei("sad", "left")
  say("@char.rei", "@rei.newsong")
  rei("smile", "left")
  say("@plat.newsong2")
  rei(nil, "left")
  say("@char.rei", "@rei.promise")
  say("@plat.call2")
  ending("next_year")
end)
